<form class="form-horizontal">
    <div class="control-group">
        <label class="control-label">{{ _('Token') }}</label>
        <div class="controls">
            <input type="text" class="input-block-level" data-bind="value: settings.plugins.prusa_connect_uploader.token" value="">
            <p class="help-block">
                {{ _('First, go to the Prusa Connect website at connect.prusa3d.com. Navigate to Cameras, then click "+ Add new other camera". Copy the provided token and paste it into this field.') }}
            </p>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Camera Name') }}</label>
        <div class="controls">
            <input type="text" class="input-block-level" placeholder="Unnamed Camera" data-bind="value: settings.plugins.prusa_connect_uploader.camera_name">
            <p class="help-block">
                {{ _('Optional. Renames the camera in Prusa Connect when settings are saved. Leave empty to keep the current name.') }}
            </p>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Upload Interval (seconds)') }}</label>
        <div class="controls">
            <input type="number" class="input-block-level" data-bind="value: settings.plugins.prusa_connect_uploader.upload_interval">
        </div>
    </div>
</form>
